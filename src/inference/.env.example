# Copy to .env or export in your shell before starting uvicorn.

LECTUREBUDDY_MOCK=1
LECTUREBUDDY_MODEL_ID=MCG-NJU/VideoChat3-4B
LECTUREBUDDY_HOST=127.0.0.1
LECTUREBUDDY_PORT=8000

# auto | 4bit | 8bit  — use 4bit on ~6GB VRAM (RTX 3060 Laptop)
LECTUREBUDDY_LOAD_MODE=4bit

LECTUREBUDDY_MAX_NEW_TOKENS=512
LECTUREBUDDY_VIDEO_FPS=1.0
LECTUREBUDDY_MAX_FRAMES=64
LECTUREBUDDY_MAX_PIXELS=151200
LECTUREBUDDY_PRELOAD=1
